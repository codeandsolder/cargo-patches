+    #[test]
+    fn negative_bearing_expands_ink_bounds() {
+        let mut renderer = new_renderer();
+        renderer.font = Font::new(SHAPING_FIXTURE, 0);
+        renderer.px_size = 100.0;
+        renderer.update_title("j");
+        let pixmap = renderer.pixmap().unwrap();
+        // Advance is 45 px, left ink overhang is 10 px at 100 ppem.
+        assert!(pixmap.width() > 45);
+        assert!(pixmap.pixels().iter().any(|pixel| pixel.alpha() > 0));
+    }
+
+    #[test]
+    fn script_itemization_preserves_combining_marks_and_neutrals() {
+        let text = " (A\u{301}) 日本語";
+        let runs = script_runs(text);
+        assert_eq!(runs.len(), 2);
+        assert_eq!(&text[runs[0].0.clone()], " (A\u{301}) ");
+        assert_eq!(&text[runs[1].0.clone()], "日本語");
+    }
+
+    #[test]
+    fn whitespace_and_control_only_titles_have_no_ink() {
+        let mut renderer = new_renderer();
+        renderer.update_title(" \t ");
+        assert!(renderer.pixmap().is_none());
     }
 }
