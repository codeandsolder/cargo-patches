-                    if color.a() == 0 {
-                        return;
-                    }
-
-                    let y = baseline + physical_glyph.y + pixel_y;
-                    let x = physical_glyph.x + pixel_x - min_x;
-                    if x < 0 || x >= width as i32 {
-                        return;
-                    }
-                    let idx = y * width as i32 + x;
-                    if idx < 0 {
-                        return;
-                    }
-                    if let Some(pixel) = pixels.get_mut(idx as usize) {
