+/// Split one directional run at changes of specific script. Leading
+/// Common/Inherited characters join the first specific script; subsequent
+/// neutral and combining characters remain with their preceding script.
+fn script_runs(text: &str) -> Vec<(Range<usize>, Option<Script>)> {
+    let mut runs = Vec::new();
+    let mut start = 0;
+    let mut previous = None;
+    for (index, ch) in text.char_indices() {
+        let script = harfrust::unicode::script(u32::from(ch));
+        if matches!(script, Script::COMMON | Script::INHERITED | Script::UNKNOWN) {
+            continue;
+        }
+        if let Some(old) = previous {
+            if old != script {
+                runs.push((start..index, Some(old)));
+                start = index;
+            }
+        }
+        previous = Some(script);
+    }
+    if start < text.len() {
+        runs.push((start..text.len(), previous));
+    }
+    runs
