+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::Write;
+    use std::mem::{offset_of, size_of};
+    use std::os::unix::net::UnixStream;
+
+    // Compared by the patch-family gate with the installed Linux UAPI header.
+    #[test]
+    fn kernel_abi_layout() {
+        println!(
+            "IPMI_ABI {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {}",
+            size_of::<IpmiMessage>(),
+            size_of::<IpmiRequest>(),
+            size_of::<IpmiRecv>(),
+            size_of::<IpmiReceiveAddr>(),
+            size_of::<IpmiSysIfaceAddr>(),
+            size_of::<IpmiIpmbAddr>(),
+            offset_of!(IpmiMessage, data_len),
+            offset_of!(IpmiMessage, data),
+            offset_of!(IpmiRequest, addr_len),
+            offset_of!(IpmiRequest, msg_id),
+            offset_of!(IpmiRequest, message),
+            offset_of!(IpmiRecv, addr),
+            offset_of!(IpmiRecv, addr_len),
+            offset_of!(IpmiRecv, msg_id),
+            offset_of!(IpmiRecv, message),
+            offset_of!(IpmiReceiveAddr, data),
+            offset_of!(IpmiSysIfaceAddr, lun),
+            offset_of!(IpmiIpmbAddr, target_addr),
+            ioctl::SEND,
+            ioctl::RECEIVE,
+            ioctl::GET_ADDRESS
+        );
+    }
+
+    fn received(netfn: u8, len: u16) -> IpmiRecv {
+        IpmiRecv {
+            recv_type: 1,
+            addr: std::ptr::null_mut(),
+            addr_len: 0,
+            msg_id: 23,
+            message: IpmiMessage {
+                netfn,
+                cmd: 1,
+                data_len: len,
+                data: std::ptr::null_mut(),
+            },
+        }
+    }
+
+    #[test]
+    fn response_decoding_uses_the_owned_buffer_not_the_kernel_pointer() {
+        let buffer = [0, 0x12, 0x34, 0xff];
+        let response = received(7, 3).into_response(&buffer).unwrap();
+        assert_eq!(response.seq(), 23);
+        assert_eq!(response.cc(), 0);
+        assert_eq!(response.data(), &[0x12, 0x34]);
+        for (netfn, len) in [(7, 5), (7, 0), (6, 3)] {
+            assert_eq!(
+                received(netfn, len)
+                    .into_response(&buffer)
+                    .unwrap_err()
+                    .kind(),
+                io::ErrorKind::InvalidData
+            );
+        }
+    }
+
+    #[test]
+    fn poll_distinguishes_timeout_and_readable_data() {
+        let (reader, mut writer) = UnixStream::pair().unwrap();
+        assert_eq!(
+            wait_readable(&reader, Duration::ZERO).unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+        writer.write_all(&[1]).unwrap();
+        wait_readable(&reader, Duration::ZERO).unwrap();
+    }
+
+    #[test]
+    fn invalid_ioctl_device_preserves_errno() {
+        let file = std::fs::File::open("/dev/null").unwrap();
+        assert_eq!(ioctl::get_address(file).unwrap_err(), Errno::NOTTY);
+    }
+}
