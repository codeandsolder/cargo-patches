+
+#[cfg(all(test, target_os = "linux"))]
+mod tests {
+    use super::{Timex, adjtimex};
+
+    #[test]
+    fn zero_mode_is_a_read_only_kernel_query() {
+        let mut tx = Timex::new();
+        assert_eq!(tx.0.modes, 0);
+        // A read-only query needs no CAP_SYS_TIME on a normal Linux kernel.
+        let state = adjtimex(&mut tx).expect("query kernel clock discipline");
+        assert!(state >= 0);
+        assert_eq!(tx.0.modes, 0);
+    }
+}
