+    #[test]
+    fn mixed_text_sequence_round_trip() {
+        #[derive(Debug, PartialEq, serde::Serialize, serde::Deserialize)]
+        enum Item {
+            #[serde(rename = "$text")]
+            Text(String),
+            Marker,
+        }
+        #[derive(Debug, PartialEq, serde::Serialize, serde::Deserialize)]
+        struct Root {
+            #[serde(rename = "$value")]
+            items: Vec<Item>,
+        }
+        let root = Root { items: vec![Item::Text("a & b".into()), Item::Marker, Item::Text("c".into())] };
+        let xml = crate::se::to_string(&root).unwrap();
+        assert_eq!(xml, "<Root>a &amp; b<Marker/>c</Root>");
+        assert_eq!(crate::de::from_str::<Root>(&xml).unwrap(), root);
+        let single = Root { items: vec![Item::Text("a".into())] };
+        let xml = crate::se::to_string(&single).unwrap();
+        assert_eq!(xml, "<Root>a</Root>");
+        assert_eq!(crate::de::from_str::<Root>(&xml).unwrap(), single);
+    }
+
+    #[test]
+    fn absent_items_do_not_delimit_text() {
+        #[derive(serde::Serialize)]
+        struct Root {
+            #[serde(rename = "$value")]
+            items: Vec<Option<String>>,
+        }
+        let root = Root { items: vec![Some("a".into()), None, Some("b".into())] };
+        assert!(crate::se::to_string(&root).is_err());
+        let root = Root { items: vec![None, Some("a".into()), None] };
+        assert_eq!(crate::se::to_string(&root).unwrap(), "<Root>a</Root>");
+    }
