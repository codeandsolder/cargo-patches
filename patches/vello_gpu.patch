+    /// Prepare a subset of monochrome outline glyphs for external GPU drawing.
+    ///
+    /// Each glyph is resolved through the normal text cache at the given physical
+    /// size and hinting policy. The returned object pins its slots and retains the
+    /// sampled textures. No text layout or repeated glyph rasterization is needed
+    /// by the consumer after preflight.
+    #[cfg(all(feature = "text", feature = "full_image_support"))]
+    pub fn prepare_outline_glyphs(
+        &mut self,
+        resources: &mut Resources,
+        font: &crate::peniko::FontData,
+        style: OutlineGlyphStyle<'_>,
+        glyph_ids: &[u32],
+    ) -> Result<PreparedOutlineGlyphs, PrepareOutlineGlyphsError> {
+        if !style.font_size.is_finite()
+            || style.font_size <= 0.0
+            || style
+                .normalized_coords
+                .iter()
+                .any(|&c| !(-16384..=16384).contains(&c))
+        {
+            return Err(PrepareOutlineGlyphsError::Unavailable);
+        }
+        resources.ensure_glyph_resources();
+        resources
+            .glyph_resources
+            .as_mut()
+            .unwrap()
+            .glyph_atlas
+            .begin_outline_lease_capture();
+        let mut scene = Scene::new(1, 1);
+        scene.set_paint(crate::peniko::color::palette::css::BLACK);
+        let result = scene
+            .glyph_run(resources, font)
+            .font_size(style.font_size)
+            .hint(style.hint)
+            .normalized_coords(style.normalized_coords)
+            .atlas_cache(true)
+            .fill_glyphs(
+                glyph_ids
+                    .iter()
+                    .copied()
+                    .map(|id| glifo::Glyph { id, x: 0.0, y: 0.0 }),
+            );
+        let leases = resources
+            .glyph_resources
+            .as_mut()
+            .unwrap()
+            .glyph_atlas
+            .take_outline_leases();
+        if let Err(error) = self.flush_glyph_atlas(resources, &TextureBindings::new()) {
+            self.reset_and_shrink(resources);
+            return Err(PrepareOutlineGlyphsError::Render(error));
+        }
+        result.map_err(PrepareOutlineGlyphsError::Glyph)?;
+        if leases.len() != glyph_ids.len() {
+            return Err(PrepareOutlineGlyphsError::Unavailable);
+        }
+        // A subset binds only the pages that contain its leased glyphs.
+        let mut pages = Vec::new();
+        let mut original_pages = Vec::new();
+        let mut slots = Vec::with_capacity(leases.len());
+        for lease in &leases {
+            let mut slot = lease.slot();
+            let index = if let Some(index) =
+                original_pages.iter().position(|&id| id == slot.page_index)
+            {
+                index
+            } else {
+                let index = pages.len();
+                original_pages.push(slot.page_index);
+                pages.push(self.resources.atlas_texture_views[slot.page_index as usize].clone());
+                index
+            };
+            slot.page_index = index as u32;
+            slots.push(slot);
+        }
+        Ok(PreparedOutlineGlyphs {
+            _leases: leases,
+            slots,
+            pages,
+        })
+    }
