+    fn compare(engine: &impl Engine, scalar: &GeneralPurpose) {
+        let mut data = [0u8; 2080];
+        let mut state = 0x12345678u32;
+        for x in &mut data {
+            state ^= state << 13;
+            state ^= state >> 17;
+            state ^= state << 5;
+            *x = state as u8;
+        }
+        let mut output = [0u8; 2800];
+        let mut recovered = [0u8; 2081];
