+#[inline(always)]
+fn encode_ascii<const URL: bool>(v: B32) -> B32 {
+    let s = v.cast::<i8>();
+    let base = s.simd_gt(Vector::splat(51)).select(
+        B32::splat(252),
+        s.simd_gt(Vector::splat(25))
