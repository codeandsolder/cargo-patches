+
+    fn update_http2_observation<T, B>(&self, conn: &Connection<T, B>)
+    where
+        T: AsyncRead + AsyncWrite + Unpin,
+        B: bytes::Buf,
+    {
+        let mut info = self.observation.lock().unwrap();
+        if !info.peer_settings_received {
+            if let Some(settings) = conn.remote_initial_settings() {
+                info.peer_settings_received = true;
+                info.peer_settings = settings
+                    .observed_settings()
+                    .unwrap_or_default()
+                    .iter()
+                    .map(|setting| (setting.id(), setting.value()))
+                    .collect();
+            }
+        }
+        if info.first_connection_window_update.is_none() {
+            info.first_connection_window_update = conn.remote_first_connection_window_update();
+        }
+        if !info.peer_settings_ack_received {
+            info.peer_settings_ack_received = conn.remote_initial_settings_ack_received();
