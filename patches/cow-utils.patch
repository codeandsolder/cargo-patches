+#[cfg(all(test, not(feature = "nightly")))]
+mod checked_pattern_tests {
+    use super::*;
+
+    struct InvalidPattern;
+
+    impl<'s> Pattern<'s> for InvalidPattern {
+        type MatchIndices = core::iter::Once<(usize, &'s str)>;
+
+        fn match_indices_in(self, _s: &'s str) -> Self::MatchIndices {
+            core::iter::once((usize::MAX, ""))
+        }
+    }
+
+    #[test]
+    #[should_panic]
+    fn invalid_custom_pattern_is_checked() {
+        let _ = "abc".cow_replace(InvalidPattern, "x");
+    }
+
+    #[test]
+    fn allocation_behavior_and_unicode_are_preserved() {
+        assert!(matches!("abc".cow_replace('z', ""), Cow::Borrowed("abc")));
+        assert!(matches!("$$str$$".cow_replace('$', ""), Cow::Borrowed("str")));
+        assert_eq!("ΑΒΣ".cow_to_lowercase(), "ΑΒΣ".to_lowercase());
+        assert_eq!("Straße".cow_to_uppercase(), "Straße".to_uppercase());
+        assert_eq!("αAbβ".cow_to_ascii_lowercase(), "αabβ");
+    }
+}
