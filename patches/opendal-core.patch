+
+#[cfg(test)]
+#[test]
+fn system_time_conversion_preserves_fraction_and_pre_epoch() {
+    for ms in [-1234_i64, -1, 0, 1, 1234] {
+        let expected = if ms < 0 {
+            UNIX_EPOCH - Duration::from_millis(ms.unsigned_abs())
+        } else {
+            UNIX_EPOCH + Duration::from_millis(ms.unsigned_abs())
+        };
+        let timestamp = Timestamp::from_millisecond(ms).unwrap();
+        assert_eq!(SystemTime::from(timestamp), expected);
+        assert_eq!(Timestamp::try_from(expected).unwrap(), timestamp);
+    }
+}
