+fn format_float(value: f64) -> Cow<'static, str> {
+    if value == f64::INFINITY {
+        Cow::Borrowed(POSITIVE_INF)
+    } else if value == f64::NEG_INFINITY {
+        Cow::Borrowed("-Inf")
+    } else if value.is_nan() {
+        Cow::Borrowed("NaN")
+    } else {
+        Cow::Owned(value.to_string())
+    }
+}
